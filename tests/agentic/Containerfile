# Image running the agentic CLIs under test in isolation from the host.
#
# PACKAGES is supplied by tests/agentic/_tools.py from the AGENTIC_TOOLS registry, so
# adding a tool there is the only edit needed to get it installed here. The image tag
# embeds a hash of the package list and of this file, so any change rebuilds
# automatically (see tests/agentic/_podman.py:image_tag).
ARG NODE_IMAGE=docker.io/library/node:24-slim
FROM ${NODE_IMAGE}

#: Space-separated npm specifiers for the agentic CLIs, e.g. "@openai/codex@latest".
ARG PACKAGES

# git and ripgrep are used by the CLIs' own shell/search tools when exploring /src.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g --no-fund --no-audit ${PACKAGES} \
    && npm cache clean --force

# Recorded at build time so the test session header can report the exact versions
# that were installed, which "@latest" alone does not pin.
RUN npm ls -g --depth=0 --json > /opt/agentic-packages.json

# The tests bind-mount a per-test working directory and run with --userns=keep-id,
# so the runtime UID is the host user's and never needs to match a baked-in account.
WORKDIR /work
